{
  "name": "mirsad-paper-forward",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "types": "mkdir -p node_modules/.cache && wrangler types node_modules/.cache/worker-configuration.d.ts",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "node --test test/worker.test.mjs",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.137.0",
    "typescript": "7.0.2",
    "esbuild": "0.28.1",
    "miniflare": "5.20260921.0-alpha"
  }
}
